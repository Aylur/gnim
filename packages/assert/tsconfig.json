{
    "compilerOptions": {
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "noEmit": true,

        "module": "ES2022",
        "target": "ES2024",
        "lib": ["ESNext"],

        "skipLibCheck": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "moduleResolution": "Bundler",
        "types": ["gi"],
        "typeRoots": ["../../.gnim/types"]
    },
    "include": ["./lib/**/*"]
}
